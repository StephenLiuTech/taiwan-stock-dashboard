##################################################
# Application
##################################################

PAMS_ENVIRONMENT=development
PAMS_LOG_LEVEL=INFO
PAMS_DATABASE_URL=sqlite:///data/pams.db
# Used only by `python -m pams migrate`; destination is PAMS_DATABASE_URL.
PAMS_MIGRATION_SOURCE_URL=
PAMS_APP_TITLE=PAMS
PAMS_MARKET_HTTP_TIMEOUT_SECONDS=15
# Total attempts, including the initial request. Maximum: 4.
PAMS_MARKET_HTTP_ATTEMPTS=4

##################################################
# Optional US Market Data and FX
##################################################

# Choose disabled (default) or alphavantage. Taiwan-only operation needs neither.
PAMS_US_MARKET_DATA_PROVIDER=disabled
PAMS_FX_PROVIDER=disabled
PAMS_ALPHA_VANTAGE_API_KEY=

##################################################
# Email Transport
##################################################

# Choose exactly one: resend, microsoft_graph, or smtp.
PAMS_EMAIL_TRANSPORT=resend

##################################################
# SMTP
##################################################

PAMS_SMTP_HOST=
PAMS_SMTP_PORT=587
PAMS_SMTP_USERNAME=
PAMS_SMTP_PASSWORD=

##################################################
# Microsoft Graph
##################################################

PAMS_MICROSOFT_CLIENT_ID=
PAMS_MICROSOFT_TENANT=consumers
PAMS_MICROSOFT_TOKEN_CACHE=

##################################################
# Resend
##################################################

PAMS_RESEND_API_KEY=

##################################################
# Public Report Assets (required for Resend charts)
##################################################

PAMS_SUPABASE_URL=
PAMS_SUPABASE_SERVICE_ROLE_KEY=
PAMS_REPORT_ASSET_BUCKET=pams-report-assets
# Optional. Use a stable, random deployment-specific prefix.
PAMS_REPORT_ASSET_PREFIX=

##################################################
# Common Email
##################################################

PAMS_EMAIL_FROM=
PAMS_EMAIL_TO=

##################################################
# Daily Report Sections
##################################################

PAMS_REPORT_SHOW_ALLOCATION=true
PAMS_REPORT_SHOW_MARKET_SNAPSHOT=true
PAMS_REPORT_SHOW_UPCOMING_EVENTS=true
PAMS_REPORT_SHOW_DIVIDENDS=true
PAMS_REPORT_SHOW_AI_NEWS=true
PAMS_REPORT_SHOW_SEMICONDUCTOR_NEWS=true
PAMS_REPORT_SHOW_INSIGHTS=true
PAMS_REPORT_SHOW_RISK=true
PAMS_REPORT_SHOW_WATCHLIST=true
PAMS_REPORT_SHOW_TRANSACTIONS=true
PAMS_REPORT_EVENT_HORIZON_DAYS=30
# current_year (default), next_90_days, or all
PAMS_REPORT_DIVIDEND_SCOPE=current_year
PAMS_REPORT_HIDE_EMPTY_OPTIONAL_SECTIONS=true
PAMS_REPORT_NEWS_LIMIT=5
PAMS_RISK_SINGLE_HOLDING_WARNING_PCT=30
PAMS_RISK_TOP3_WARNING_PCT=70
PAMS_RISK_MARKET_WARNING_PCT=80
